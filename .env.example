# Runtime settings; replace the examples before starting a shared or production deployment.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set both values explicitly to create the first local administrator on API startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdfreview
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./storage/uploads
RENDER_DIR=./storage/render
REPORT_DIR=./storage/reports
MAX_FILE_SIZE=10485760
MAX_PAGES=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
